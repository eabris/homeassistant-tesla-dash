# ===== TeslaMate Configuration =====

# Database Password (PostgreSQL)
# Used by: database, teslamate
# ⚠️ CHANGE THIS to a secure password
DB_PASSWORD=teslamate_secure_password_change_me

# MQTT Broker Password
# Used by: teslamate, Home Assistant MQTT integration
# ⚠️ CHANGE THIS to a secure password
MQTT_PASSWORD=teslamate_mqtt_secure_change_me

# Tesla API Encryption Key
# Used by: teslamate (for storing/encrypting Tesla API tokens)
# Generate a random 32-character string (or use: openssl rand -hex 16)
# ⚠️ MUST BE SET - generate a new one and keep it safe
ENCRYPTION_KEY=your_random_32_char_encryption_key_generated_here

# Grafana Admin Password
# Used by: Grafana web UI (http://localhost:3000)
# ⚠️ CHANGE THIS to a secure password
GRAFANA_PASSWORD=grafana_secure_password_change_me

# ===== Optional: Home Assistant Integration =====

# Home Assistant MQTT Integration Configuration (add to configuration.yaml)
# mqtt:
#   broker: localhost    # or your Docker host IP if on separate machine
#   port: 1883
#   username: teslamate
#   password: {{ MQTT_PASSWORD from above }}
#   discovery: true
#   discovery_prefix: homeassistant
