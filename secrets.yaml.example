# Copy this file to secrets.yaml (same folder) and fill in real values.
# secrets.yaml is git-ignored — never commit your real one.
#
# Required by the tesla_window_close_gps rest_command in configuration.yaml
# (a workaround for a Tesla Fleet integration bug where cover.close_cover
# passes lat=0,lon=0 and gets rejected as "too far from vehicle").
#
# tesla_fleet_token: OAuth2 access token used by the Tesla Fleet integration.
#   Find it in Home Assistant's own storage after setting up the Tesla Fleet
#   integration: Settings → Devices & Services → Tesla Fleet → (⋮) → Download
#   diagnostics, or inspect config/.storage/tesla_fleet-related entries.
# tesla_fleet_vehicle_id: the numeric vehicle ID (not VIN) for your car.
#   Find it by calling GET https://fleet-api.prd.<region>.vn.cloud.tesla.com/api/1/vehicles
#   with your bearer token — the "id" field in the JSON response.

tesla_fleet_token: "REPLACE_WITH_YOUR_TESLA_FLEET_OAUTH_TOKEN"
tesla_fleet_vehicle_id: "REPLACE_WITH_YOUR_NUMERIC_VEHICLE_ID"
